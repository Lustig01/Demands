generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Organization Models
// ============================================

model Center {
  name      String   @id
  displayName String?
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  name       String
  displayName String?
  centerName String
  center     Center    @relation(fields: [centerName], references: [name], onDelete: Cascade)
  sections   Section[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@id([name, centerName])
}

model Section {
  name           String
  displayName    String?
  branchName     String
  branchCenter   String
  branch         Branch   @relation(fields: [branchName, branchCenter], references: [name, centerName], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([name, branchName, branchCenter])
}

// ============================================
// Location Models
// ============================================

model Base {
  name      String     @id
  displayName String?
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Environment {
  name      String     @id
  displayName String?
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Network {
  name      String     @id
  displayName String?
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Location {
  id              Int         @id @default(autoincrement())
  baseName        String
  environmentName String
  networkName     String
  base            Base        @relation(fields: [baseName], references: [name], onDelete: Cascade)
  environment     Environment @relation(fields: [environmentName], references: [name], onDelete: Cascade)
  network         Network     @relation(fields: [networkName], references: [name], onDelete: Cascade)
  capacities      Capacity[]
  projects        Project[]
  demands         Demand[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([baseName, environmentName, networkName])
}

// ============================================
// Service Models
// ============================================

model Service {
  name      String     @id
  resources Resource[]
  demands   Demand[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Resource {
  name        String
  unit        String
  serviceName String
  service     Service    @relation(fields: [serviceName], references: [name], onDelete: Cascade)
  capacities  Capacity[]
  demands     Demand[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@id([name, serviceName])
}

model Capacity {
  id              Int      @id @default(autoincrement())
  locationId      Int
  resourceName    String
  resourceService String
  value           Float
  allocated       Float    @default(0)
  available       Float    @default(0)
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resource        Resource @relation(fields: [resourceName, resourceService], references: [name, serviceName], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([locationId, resourceName, resourceService])
}

// ============================================
// Request Models
// ============================================

enum ProjectType {
  Emergency
  Semiannual
}

model ProjectKind {
  name        String    @id
  displayName String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Median {
  H1
  H2
}

enum DemandType {
  New
  Extension
}

enum DemandStatus {
  Pending
  Approved
  Rejected
  PartiallyApproved
}

model Project {
  name          String      @id
  purpose       String
  type          ProjectType
  kindName      String
  kind          ProjectKind  @relation(fields: [kindName], references: [name], onDelete: Restrict)
  locationId    Int
  location      Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  year          Int?
  median        Median?
  demands       Demand[]
  createdBy     String?
  createdByName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([createdBy])
}

model Demand {
  id                 Int              @id @default(autoincrement())
  projectName        String
  project            Project          @relation(fields: [projectName], references: [name], onDelete: Cascade)
  serviceName        String
  service            Service          @relation(fields: [serviceName], references: [name], onDelete: Cascade)
  resourceName       String
  resourceService    String
  resource           Resource         @relation(fields: [resourceName, resourceService], references: [name, serviceName], onDelete: Cascade)
  value              Float
  locationId         Int
  location           Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type               DemandType
  status             DemandStatus     @default(Pending)
  clusterName        String?
  approvedValue      Float?
  approvedDate       DateTime?
  decisionReasonName String?
  decisionReason     DecisionReason?  @relation(fields: [decisionReasonName], references: [name])
  createdBy          String?
  createdByName      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([createdBy])
}

model DecisionReason {
  name        String   @id
  displayName String
  demands     Demand[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
